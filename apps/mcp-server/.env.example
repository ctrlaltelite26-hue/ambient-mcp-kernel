# Copy to .env (gitignored) and fill in:
#   cp apps/mcp-server/.env.example apps/mcp-server/.env
#
# AWS *credentials* usually come from `aws configure` (~/.aws/credentials),
# not from this file. Only put keys here if you prefer env-based auth.

# Flip to 1 to dual-write propose/commit to DynamoDB
CHAPERONE_AWS=1
AWS_REGION=us-east-1

CHAPERONE_DDB_PROPOSALS_TABLE=chaperone-proposals
CHAPERONE_DDB_LEDGER_TABLE=chaperone-ledger

# Optional — without this, ledger still dual-writes but signs with stub HMAC
# CHAPERONE_KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY_ID

# Optional stretch — does NOT own allow/deny
# CHAPERONE_BEDROCK=1

# Only if NOT using `aws configure` / SSO profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
